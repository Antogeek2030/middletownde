---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<Layout title="Blog | AC Repair Middletown DE" description="Tips and guides on AC repair, maintenance, and cooling efficiency for Middletown and New Castle County homeowners.">
  <section class="page-hero">
    <div class="container">
      <h1>AC Tips &amp; Guides</h1>
      <p>Practical advice to keep your system running and your home comfortable.</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="blog-grid">
        {posts.map((post) => (
          <a href={`/blog/${post.id}/`} class="blog-card" style="display:block">
            <div class="blog-card-body">
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <div class="blog-meta">
                {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
